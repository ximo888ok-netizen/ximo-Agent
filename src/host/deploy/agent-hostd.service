# agent-hostd — ximo-OS 阶段 0 系统服务
# 安装：sudo cp agent-hostd.service /etc/systemd/system/ && sudo systemctl enable --now agent-hostd
# 前提：WSL 需在 /etc/wsl.conf 开启 [boot] systemd=true（Windows 侧 wsl --shutdown 后重启生效）

[Unit]
Description=ximo-OS Agent Host Daemon (stage 0)
After=network-online.target ximo-os-firstboot.service ximo-wm.service
Wants=network-online.target xvfb@99.service ximo-wm.service

[Service]
Type=simple
# root + 最小能力集（阶段 D5 按任务用户沙箱）—— 需 CAP_SETUID/SETGID 把 worker
# 降权到任务用户（ximo-t1..t4）、CAP_CHOWN 移交工作区所有权、CAP_KILL 清理越界 worker。
# CapabilityBoundingSet 是白名单：未列出即不可用（其余能力全部丢弃）。
# 注意不能用 NoNewPrivileges=true —— 它会阻止 fork 出的 worker 通过 setuid 降权。
User=root
CapabilityBoundingSet=CAP_SETUID CAP_SETGID CAP_CHOWN CAP_KILL
AmbientCapabilities=
ExecStart=/usr/bin/node /opt/ximo-host/dist-host/agent-hostd.cjs
Environment=XIMO_HOST_LISTEN=0.0.0.0:17890
Environment=XIMO_HOST_DIR=/opt/ximo-host/config
Environment=XIMO_HOST_DATA=/opt/ximo-host/data
Environment=XIMO_HOST_DISPLAY=:99
Environment=XIMO_HOST_BROWSER=1
Restart=on-failure
RestartSec=3
# 日志双写 journal + 控制台 — QEMU 串口(-serial file:...)由此捕获首启令牌回显
StandardOutput=journal+console
StandardError=journal+console
# 文件系统加固 — 与能力集互补（root 但系统目录只读）
ProtectSystem=strict
ReadWritePaths=/opt/ximo-host
PrivateTmp=true

[Install]
WantedBy=multi-user.target
